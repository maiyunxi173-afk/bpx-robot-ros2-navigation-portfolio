  <version>1.0.0</version>
  <description>Cartographer mapping/localization and Nav2 navigation for BPX quadruped.</description>
  <maintainer email="maiyunxi173@users.noreply.github.com">Mai Yunxi</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>bpx_driver</exec_depend>
  <exec_depend>bpx_ekf_bringup</exec_depend>
  <exec_depend>sllidar_ros2</exec_depend>
  <exec_depend>rf2o_laser_odometry</exec_depend>
  <exec_depend>cartographer_ros</exec_depend>
  <exec_depend>nav2_bringup</exec_depend>
  <exec_depend>nav2_map_server</exec_depend>
  <exec_depend>nav2_lifecycle_manager</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>tf2_ros</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>

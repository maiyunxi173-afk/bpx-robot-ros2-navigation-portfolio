Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
  - Class: rviz_common/Tool Properties
    Name: Tool Properties

Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Map
      Name: Map
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        Value: /map
      Update Topic:
        Depth: 1
        Durability Policy: Transient Local
        Value: /map_updates
      Alpha: 0.7
      Color Scheme: map
      Draw Behind: false

    - Class: rviz_default_plugins/LaserScan
      Name: LaserScan
      Topic:
        Depth: 1
        Durability Policy: Volatile
        Value: /scan
      Style: Flat Squares
      Size (m): 0.03
      Decay Time: 0.5
      Color: 255; 0; 0

    - Class: rviz_default_plugins/TF
      Name: TF
      Frame Timeout: 15.0

    - Class: rviz_default_plugins/Odometry
      Name: Odometry (EKF)
      Topic:
        Depth: 1
        Durability Policy: Volatile
        Value: /odom
      Covariance:
        Position: false
        Orientation: false
      Keep: 100
      Shape: Arrow
      Shaft Length: 0.2
      Shaft Diameter: 0.05
      Head Length: 0.1
      Head Diameter: 0.1

    - Class: rviz_default_plugins/Path
      Name: Global Plan
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        Value: /plan
      Color: 0; 255; 0
      Line Style: Dashed
      Alpha: 0.8

    - Class: rviz_default_plugins/Path
      Name: Local Plan
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        Value: /local_plan
      Color: 0; 128; 255
      Line Style: Lines
      Alpha: 1.0

    - Class: rviz_default_plugins/Map
      Name: Global Costmap
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        Value: /global_costmap/costmap_raw
      Color Scheme: costmap
      Draw Behind: true
      Enabled: false

    - Class: rviz_default_plugins/Map
      Name: Local Costmap
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        Value: /local_costmap/costmap_raw
      Color Scheme: costmap
      Draw Behind: false
      Enabled: false

    - Class: rviz_default_plugins/RobotModel
      Name: RobotModel
      Description Source: Topic
      Description Topic:
        Depth: 1
        Durability Policy: Transient Local
        Value: /robot_description
      Enabled: false

  Enabled: true
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: map
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
    - Class: rviz_default_plugins/Measure
    - Class: nav2_rviz_plugins/GoalTool
    - Class: rviz_default_plugins/SetInitialPose
    - Class: rviz_default_plugins/PublishPoint
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 10.0
      Focal Point:
        X: 0
        Y: 0
        Z: 1
      Name: Current View
      Pitch: 0.8
      Yaw: 0.0
    Saved: {}
Window Geometry:
  Displays:
    collapsed: false
  Height: 800
  Width: 1200
